{
  "manifest_version": 3,
  "name": "LeetCode → GitHub Sync",
  "version": "0.1.0",
  "description": "Sync your latest accepted LeetCode solution to GitHub with one click.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://api.github.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sync to GitHub"
  },
  "options_page": "options.html"
}
